{
    "_comment": "yunomúsica shell. Five destinations, in the order they matter: Player (the deck: transport first, then the queue you curate), Library (five ways to look at the same tracks, switched by chips inside the view rather than by five routes), Sources (the authorised folders, which is where the app explains what it does with your disk), Lists (the queues you saved), and History (what you have actually been listening to, and the favourites that fall out of it). The default route is the player, so the first thing on screen is play/pause/next and what is sounding. Rendered as a LEFT vertical rail on desktop and a BOTTOM icon-bar on mobile. The toolbar carries the brand, the language menu, the theme toggle and the help/credits dialog, all as events the host acts on. It does NOT carry the pickers: adding music is Sources' job, and one door is better than three. No backend: a pure gobj tree with hash routing.",
    "shell": {
        "remember_section_position": true,
        "breakpoints": "bulma",
        "zones": {
            "top": {
                "host": "toolbar",
                "show_on": "*"
            },
            "left": {
                "host": "menu.primary",
                "show_on": ">=desktop"
            },
            "bottom": {
                "host": "menu.primary",
                "show_on": "<desktop"
            },
            "center": {
                "host": "stage.main"
            }
        },
        "stages": {
            "main": {
                "zone": "center",
                "default_route": "/player"
            }
        }
    },
    "toolbar": {
        "zone": "top",
        "aria_label": "Yunomúsica",
        "items": [
            {
                "id": "brand",
                "type": "brand",
                "logo": "./yunomusica-mark.svg",
                "wordmark": "Yunomúsica",
                "alt": "Yunomúsica",
                "aria_label": "player",
                "action": {
                    "type": "navigate",
                    "route": "/player"
                }
            },
            {
                "id": "language",
                "icon": "mi-globe",
                "align": "end",
                "aria_label": "language",
                "tooltip": "language",
                "action": {
                    "type": "dropdown",
                    "items": [
                        {"id": "lang-es", "name": "Español",
                         "action": {"type": "event", "event": "EV_SET_LOCALE", "kw": {"locale": "es"}}},
                        {"id": "lang-en", "name": "English",
                         "action": {"type": "event", "event": "EV_SET_LOCALE", "kw": {"locale": "en"}}},
                        {"id": "lang-zh", "name": "中文",
                         "action": {"type": "event", "event": "EV_SET_LOCALE", "kw": {"locale": "zh"}}},
                        {"id": "lang-hi", "name": "हिन्दी",
                         "action": {"type": "event", "event": "EV_SET_LOCALE", "kw": {"locale": "hi"}}},
                        {"id": "lang-ar", "name": "العربية",
                         "action": {"type": "event", "event": "EV_SET_LOCALE", "kw": {"locale": "ar"}}},
                        {"id": "lang-pt", "name": "Português",
                         "action": {"type": "event", "event": "EV_SET_LOCALE", "kw": {"locale": "pt"}}},
                        {"id": "lang-ru", "name": "Русский",
                         "action": {"type": "event", "event": "EV_SET_LOCALE", "kw": {"locale": "ru"}}},
                        {"id": "lang-ja", "name": "日本語",
                         "action": {"type": "event", "event": "EV_SET_LOCALE", "kw": {"locale": "ja"}}},
                        {"id": "lang-de", "name": "Deutsch",
                         "action": {"type": "event", "event": "EV_SET_LOCALE", "kw": {"locale": "de"}}},
                        {"id": "lang-fr", "name": "Français",
                         "action": {"type": "event", "event": "EV_SET_LOCALE", "kw": {"locale": "fr"}}}
                    ]
                }
            },
            {
                "id": "palette",
                "icon": "mi-palette",
                "align": "end",
                "aria_label": "colours",
                "tooltip": "colours",
                "action": {
                    "type": "dropdown",
                    "items": [
                        {"id": "pal-auto", "name": "palette auto",
                         "action": {"type": "event", "event": "EV_SET_PALETTE", "kw": {"palette": "auto"}}},
                        {"id": "pal-gold", "name": "palette gold",
                         "action": {"type": "event", "event": "EV_SET_PALETTE", "kw": {"palette": "gold"}}},
                        {"id": "pal-ice", "name": "palette ice",
                         "action": {"type": "event", "event": "EV_SET_PALETTE", "kw": {"palette": "ice"}}},
                        {"id": "pal-rose", "name": "palette rose",
                         "action": {"type": "event", "event": "EV_SET_PALETTE", "kw": {"palette": "rose"}}},
                        {"id": "pal-leaf", "name": "palette leaf",
                         "action": {"type": "event", "event": "EV_SET_PALETTE", "kw": {"palette": "leaf"}}}
                    ]
                }
            },
            {
                "id": "theme",
                "icon": "yi-moon",
                "align": "end",
                "aria_label": "theme",
                "tooltip": "theme",
                "action": {
                    "type": "event",
                    "event": "EV_TOGGLE_THEME"
                }
            },
            {
                "id": "help",
                "icon": "mi-info",
                "align": "end",
                "aria_label": "help",
                "tooltip": "help",
                "action": {
                    "type": "event",
                    "event": "EV_OPEN_ABOUT"
                }
            }
        ]
    },
    "menu": {
        "primary": {
            "render": {
                "left": {
                    "layout": "vertical",
                    "icon_pos": "left",
                    "show_label": true
                },
                "bottom": {
                    "layout": "icon-bar",
                    "icon_pos": "top",
                    "show_label": true
                }
            },
            "items": [
                {
                    "id": "player",
                    "name": "player",
                    "icon": "mi-disc",
                    "tooltip": "player",
                    "route": "/player",
                    "target": {
                        "stage": "main",
                        "gclass": "C_MUS_DECK",
                        "lifecycle": "keep_alive",
                        "kw": {
                            "title": "player"
                        }
                    }
                },
                {
                    "id": "library",
                    "name": "library",
                    "icon": "yi-bars",
                    "tooltip": "library",
                    "route": "/library",
                    "target": {
                        "stage": "main",
                        "gclass": "C_MUS_VIEW",
                        "lifecycle": "keep_alive",
                        "kw": {
                            "view": "artists",
                            "title": "library"
                        }
                    }
                },
                {
                    "id": "sources",
                    "name": "sources",
                    "icon": "mi-folder",
                    "tooltip": "sources",
                    "route": "/sources",
                    "target": {
                        "stage": "main",
                        "gclass": "C_MUS_SOURCES",
                        "lifecycle": "keep_alive",
                        "kw": {
                            "title": "sources"
                        }
                    }
                },
                {
                    "id": "lists",
                    "name": "lists",
                    "icon": "mi-tag",
                    "tooltip": "lists",
                    "route": "/lists",
                    "target": {
                        "stage": "main",
                        "gclass": "C_MUS_LISTS",
                        "lifecycle": "keep_alive",
                        "kw": {
                            "title": "lists"
                        }
                    }
                },
                {
                    "id": "history",
                    "name": "history",
                    "icon": "mi-clock",
                    "tooltip": "history",
                    "route": "/history",
                    "target": {
                        "stage": "main",
                        "gclass": "C_MUS_HISTORY",
                        "lifecycle": "keep_alive",
                        "kw": {
                            "title": "history"
                        }
                    }
                }
            ]
        }
    }
}
