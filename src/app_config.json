{
    "_comment": "yunomúsica shell. One primary menu with the four ways to look at the library plus the flat track list, rendered as a LEFT vertical rail on desktop and a BOTTOM icon-bar on mobile. Every leaf mounts C_MUS_VIEW with a different `view`, keep_alive so each keeps its scroll and its drill-down while you switch. The toolbar carries the brand and the two ways to load music (a folder or loose files) as events the host acts on. No submenus, no backend: a pure gobj tree with hash routing, and a player the host owns below the shell.",
    "shell": {
        "remember_section_position": true,
        "breakpoints": "bulma",
        "zones": {
            "top": {
                "host": "toolbar",
                "show_on": "*"
            },
            "left": {
                "host": "menu.primary",
                "show_on": ">=desktop"
            },
            "bottom": {
                "host": "menu.primary",
                "show_on": "<desktop"
            },
            "center": {
                "host": "stage.main"
            }
        },
        "stages": {
            "main": {
                "zone": "center",
                "default_route": "/artistas"
            }
        }
    },
    "toolbar": {
        "zone": "top",
        "aria_label": "Yunomúsica",
        "items": [
            {
                "id": "brand",
                "type": "brand",
                "logo": "./yunomusica-mark.svg",
                "wordmark": "Yunomúsica",
                "alt": "Yunomúsica",
                "aria_label": "Inicio",
                "action": {
                    "type": "navigate",
                    "route": "/artistas"
                }
            },
            {
                "id": "pick-dir",
                "icon": "mi-folder",
                "name": "Carpeta",
                "align": "end",
                "aria_label": "Elegir una carpeta",
                "tooltip": "Elegir una carpeta de música",
                "action": {
                    "type": "event",
                    "event": "EV_PICK_DIR"
                }
            },
            {
                "id": "pick-files",
                "icon": "yi-upload",
                "align": "end",
                "aria_label": "Elegir ficheros",
                "tooltip": "Elegir ficheros sueltos",
                "action": {
                    "type": "event",
                    "event": "EV_PICK_FILES"
                }
            },
            {
                "id": "theme",
                "icon": "yi-moon",
                "align": "end",
                "aria_label": "Cambiar tema",
                "tooltip": "Tema claro / oscuro",
                "action": {
                    "type": "event",
                    "event": "EV_TOGGLE_THEME"
                }
            }
        ]
    },
    "menu": {
        "primary": {
            "render": {
                "left": {
                    "layout": "vertical",
                    "icon_pos": "left",
                    "show_label": true
                },
                "bottom": {
                    "layout": "icon-bar",
                    "icon_pos": "top",
                    "show_label": true
                }
            },
            "items": [
                {
                    "id": "artistas",
                    "name": "Artistas",
                    "icon": "yi-user",
                    "tooltip": "La música agrupada por artista",
                    "route": "/artistas",
                    "target": {
                        "stage": "main",
                        "gclass": "C_MUS_VIEW",
                        "lifecycle": "keep_alive",
                        "kw": {
                            "view": "artistas",
                            "title": "Artistas"
                        }
                    }
                },
                {
                    "id": "albumes",
                    "name": "Álbumes",
                    "icon": "mi-disc",
                    "tooltip": "La música agrupada por álbum",
                    "route": "/albumes",
                    "target": {
                        "stage": "main",
                        "gclass": "C_MUS_VIEW",
                        "lifecycle": "keep_alive",
                        "kw": {
                            "view": "albumes",
                            "title": "Álbumes"
                        }
                    }
                },
                {
                    "id": "generos",
                    "name": "Géneros",
                    "icon": "mi-tag",
                    "tooltip": "La música agrupada por género",
                    "route": "/generos",
                    "target": {
                        "stage": "main",
                        "gclass": "C_MUS_VIEW",
                        "lifecycle": "keep_alive",
                        "kw": {
                            "view": "generos",
                            "title": "Géneros"
                        }
                    }
                },
                {
                    "id": "carpetas",
                    "name": "Carpetas",
                    "icon": "mi-folder",
                    "tooltip": "La música tal como está en las carpetas",
                    "route": "/carpetas",
                    "target": {
                        "stage": "main",
                        "gclass": "C_MUS_VIEW",
                        "lifecycle": "keep_alive",
                        "kw": {
                            "view": "carpetas",
                            "title": "Carpetas"
                        }
                    }
                },
                {
                    "id": "pistas",
                    "name": "Todas",
                    "icon": "yi-bars",
                    "tooltip": "Todas las pistas, en una sola lista",
                    "route": "/pistas",
                    "target": {
                        "stage": "main",
                        "gclass": "C_MUS_VIEW",
                        "lifecycle": "keep_alive",
                        "kw": {
                            "view": "pistas",
                            "title": "Todas"
                        }
                    }
                }
            ]
        }
    }
}
